{
  "name": "@abhi1693/medusa-payment-razorpay",
  "version": "0.0.2",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json",
    "test": "vitest run",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "lint": "eslint src tests --max-warnings=0",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile=test-results/vitest.xml",
    "package:check": "npm run build && node scripts/check-package.mjs"
  },
  "peerDependencies": {
    "@medusajs/framework": "2.22.2 || 2.22.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@medusajs/framework": "2.22.4",
    "@types/node": "^24.0.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "description": "Razorpay payment provider for Medusa v2 with INR test/live checkout, refunds, signed webhooks and reconciliation helpers.",
  "author": "Abhimanyu Saharan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhi1693/medusa-payment-razorpay.git"
  },
  "homepage": "https://github.com/abhi1693/medusa-payment-razorpay#readme",
  "bugs": {
    "url": "https://github.com/abhi1693/medusa-payment-razorpay/issues"
  },
  "keywords": [
    "medusa",
    "medusajs",
    "medusa-v2",
    "razorpay",
    "payment-provider",
    "payments",
    "inr",
    "refunds",
    "webhooks",
    "medusa-plugin",
    "ecommerce",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/abhi1693"
  }
}
